# backend/.env.example

# Database connection string (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodnumbers?schema=public"

# Auth.js Configuration
# Generate a secret: npx auth secret
AUTH_SECRET=

# Google OAuth Credentials
# Obtain these from the Google Cloud Console (https://console.cloud.google.com/)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# CSRF & Cookie Protection
# CSRF_SECRET must be exactly 32 characters long (required by tiny-csrf)
CSRF_SECRET=
COOKIE_SECRET=

# AI Features (Gemini)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Server Port (default: 4000 for backend)
PORT=4000

# Node Environment (development/production/test)
NODE_ENV=development
