# file: backend/justfile
# This file manages the external Docker services required by the backend.
# All npm-related commands should be run from the monorepo root (e.g., `npm test -w backend`).

# --- SERVICE MANAGEMENT (for Development & Testing) ---
services-up:
    @echo "Starting Redis container for development..."
    @docker compose up -d

services-down:
    @echo "Stopping and removing development Redis container..."
    @docker compose down

test-env-up:
    @echo "Starting Redis container for testing..."
    @docker compose up -d redis

test-env-down:
    @echo "Stopping Redis container for testing..."
    @docker compose down

# --- ORCHESTRATION WORKFLOWS ---
# This is a high-value recipe for running a full CI-style test cycle locally.
test-ci:
    @echo "Running CI test cycle: Starting services -> Running tests -> Tearing down..."
    @just test-env-up
    @npm test -w backend # Corrected to use monorepo npm script
    @just test-env-down
