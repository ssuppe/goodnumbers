{
  "name": "goodnumbers",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop ecosystem.config.cjs && pm2 delete ecosystem.config.cjs",
    "dev:server": "nodemon --watch src --ext ts --exec \"npm run build && node ./dist/server.js\"",
    "dev:worker": "nodemon --watch src --ext ts --exec \"npm run build && node ./dist/worker.js\"",
    "dev": "npm run dev:server",
    "logs": "pm2 logs",
    "build": "npx prisma generate && tsc --build",
    "postinstall": "npm run build -w @goodnumbers/schemas && npm run build -w @goodnumbers/types",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prettier": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@auth/express": "^0.11.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@goodnumbers/common": "file:../packages/common",
    "@goodnumbers/schemas": "file:../packages/schemas",
    "@goodnumbers/types": "file:../packages/types",
    "@prisma/client": "^6.14.0",
    "axios": "^1.13.2",
    "body-parser": "^1.20.2",
    "bullmq": "^5.60.0",
    "cookie-parser": "^1.4.6",
    "d3-array": "^3.2.4",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "luxon": "^3.7.2",
    "pm2": "^6.0.13",
    "prisma": "^6.14.0",
    "tiny-csrf": "^1.1.4",
    "uuid": "^13.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/d3-array": "^3.2.2",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "fast-check": "^4.5.2",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prismock": "^1.35.4",
    "supertest": "^7.1.4",
    "supertest-session": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
