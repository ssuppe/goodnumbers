# === GLOBAL CONFIG ===
# Node environment (development, production, test)
NODE_ENV=development
# Port for the Backend server
PORT=4000
# Vite Frontend port
VITE_PORT=5173
# Frontend API URL (for Vite proxy or direct access)
VITE_API_URL=http://localhost:4000

# === DATABASE & REDIS ===
# Database connection (PostgreSQL or SQLite)
# For local dev with SQLite: file:./backend/prisma/dev.db
DATABASE_URL="file:./backend/prisma/dev.db"

# Redis configuration (Required for background jobs)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=a-very-secure-password
REDIS_DB=0
QUEUE_NAME=journal-processing

# === AUTHENTICATION (Auth.js) ===
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=
# The absolute URL of the frontend (e.g., http://localhost:5173 in dev)
AUTH_URL=http://localhost:5173

# === SECURITY ===
# CSRF_SECRET must be 32 characters long
CSRF_SECRET=
COOKIE_SECRET=
# 64-character hex string for sensitive data encryption
ENCRYPTION_KEY=

# === AI & INTEGRATIONS ===
# Google AI Studio API Key (Gemini)
GEMINI_API_KEY=

# === DEPLOYMENT (Optional) ===
# Local path to your GCP service account key
GCP_KEY_PATH="~/.gcp/goodnumbers-key.json"
# VPS Deployment settings
DEPLOY_SERVER_IP=
DEPLOY_SERVER_USER=
# Remote path for GCP key on the server (optional, defaults to /home/{{user}}/secrets/gcp-key.json)
GCP_KEY_PATH_SERVER=
