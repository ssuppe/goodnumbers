{
    "version": 2,
    "functions": {
      "api/index.py": {
        "runtime": "@vercel/python@3.12",
        "includeFiles": "api/**/*", 
        "maxDuration": 60
      }
    },
    "routes": [
      {
        "src": "/api/py/(.*)",
        "dest": "api/index.py"
      },
      {
        "src": "/(.*)",
        "dest": "/.next/serverless/pages/$1"
      }
  
    ]
  }