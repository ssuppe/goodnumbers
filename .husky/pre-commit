#!/usr/bin/env bash

# Unset variables for compatibility with git worktrees
unset GIT_DIR
unset GIT_WORK_TREE

# --- Check for staged files ---
STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
  echo "› No staged files found. Skipping pre-commit checks."
  exit 0
fi

# --- Check for docs-only changes ---
ONLY_SKIP_ALLOWED=true
for FILE in $STAGED_FILES; do
  case "$FILE" in
    docs/* | *.code-workspace | .gemini/* | GEMINI.md | docs/main/TASKS.md)
      ;;
    *)
      ONLY_SKIP_ALLOWED=false
      break
      ;;
  esac
done

if [ "$ONLY_SKIP_ALLOWED" = true ]; then
  echo "› Skipping checks for docs/metadata-only changes."
  exit 0
fi

echo "› Running lint-staged..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Linting failed."
  exit 1
fi

echo "› Running type check..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Type check or build failed."
  exit 1
fi

echo "✅ Pre-commit checks passed."
