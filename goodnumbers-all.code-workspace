{
  "folders": [
    {
      "path": "./goodnumbers",
      "name": "Next.js Frontend"
    },
    {
      "path": "./goodnumbers-be",
      "name": "FastAPI Backend"
    },
    {
      "path": "."
    },
    {
      "path": "../../envs"
    }
  ],
  "settings": {
    // Workspace-specific settings go here
    "editor.formatOnSave": true,
    // You can override settings per-language
    "[python]": {
      "editor.defaultFormatter": "ms-python.autopep8"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.associations": {
      ".vercelignore": "plaintext",
      ".gitignore": "plaintext"
    }
  },
  "extensions": {
    "recommendations": ["ms-python.python", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
  }
}
