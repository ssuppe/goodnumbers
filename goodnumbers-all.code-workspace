{
  "folders": [
    {
      "path": "./backend",
      "name": "backend"
    },
    { "path": "./frontend",
      "name": "frontend"
    },
    {
      "path": "./packages",
      "name": "packages"
    },
    {
      "path": "./docs",
      "name": "Docs"
    },
    {
      "path": "./proof_of_concept",
      "name": "proof_of_concept"
    },
    {
      "path": "./.agent",
      "name": "agent"
    }
	
  ],
  "settings": {
    // Workspace-specific settings go here
    "editor.formatOnSave": true,
    // You can override settings per-language
    "[python]": {
      "editor.defaultFormatter": "ms-python.autopep8"
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.associations": {
      ".vercelignore": "plaintext",
      ".gitignore": "plaintext",
      "*.css": "tailwindcss"
    }
  },
  "extensions": {
    "recommendations": ["ms-python.python", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
  }
}
