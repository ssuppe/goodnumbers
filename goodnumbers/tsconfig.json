{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleResolution": "NodeNext",
    "types": ["jest", "node"] // Explicitly include Jest and Node types
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
